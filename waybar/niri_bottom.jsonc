// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    "spacing": 0, // Gaps between modules (4px)
    "margin-top" : 0,
    "margin-bottom": 0,
    "margin-left" : 0,
    "margin-right" : 0,
    "modules-left": [
             ],
    "modules-center": [
   "custom/button1",
    "custom/button2",
    "custom/button3",
    "custom/button4",
    "custom/button5",
    "custom/button6",
    "custom/button7",
    "custom/button8",
    "custom/button9",
    "custom/button10",

    "custom/power",
    "network",
    "bluetooth",
    "cpu",
    "memory",
    "pulseaudio", 
    "clock",
      "battery"
    
    
    ],
    "modules-right": [
     
    ],
"custom/button1": {
"format":"[ 一",
"tooltip": false,
"on-click":  "niri msg action focus-workspace 1"
},

"custom/button2": {
"format":"二",
"tooltip": false,
"on-click": "niri msg action focus-workspace 2"
},

"custom/button3": {
"format":"三",
"tooltip": false,
"on-click": "niri msg action focus-workspace 3"
},

"custom/button4": {
"format":"四",
"tooltip": false,
"on-click": "niri msg action focus-workspace 4"
},

"custom/button5": {
"format":"五",
"tooltip": false,
"on-click": "niri msg action focus-workspace 5"
},

"custom/button6": {
"format":"六",
"tooltip": false,
"on-click": "niri msg action focus-workspace 6"
},

"custom/button7": {
"format":"七",
"tooltip": false,
"on-click": "niri msg action focus-workspace 7"
},

"custom/button8": {
"format":"八",
"tooltip": false,
"on-click": "niri msg action focus-workspace 8"
},

"custom/button9": {
"format":"九",
"tooltip": false,
"on-click": "niri msg action focus-workspace 9"
},

"custom/button10": {
"format":"十 ]",
"tooltip": false,
"on-click": "niri msg action focus-workspace 10"
},

    "cpu": {
        "format": "[   {usage}% CPU ]",
        "tooltip": false
    },
    "memory": {
        "format": "[   {}% RAM ]"
    },
       "clock": {
        "tooltip": false,
        "format": "[ 󰥔  {:%I:%M%p} ]"
    },

    "battery": {
        "tooltip": false,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "[ {icon} {capacity}% ]",
        "format-full": "[ {icon} {capacity}% ]",
        "format-charging": "[ {icon} {capacity}% ]",
        "format-plugged": "[ {icon} {capacity}% ]",
        "format-icons": [ " ", " ", " ", " " ]
    },
"network": {
"tooltip": false,
"format":"[ {icon} Wifi ]",
"interface": "wlp0s20f3",
"interval": 5,
"format-wifi": "[ 󰤨  Wifi ]", 
"format-ethernet": "[ 󰤨  LAN ]",               
"format-disconnected": "[ 󰤯  Disconnected ]", 
"on-click": "nm-connection-editor"    
},
"bluetooth": {
	"format": "[  Bluetooth ]",
	"format-connected": "[  {device_alias} ]",
	"format-connected-battery": "[  {device_alias} {device_battery_percentage}% ]",
	// "format-device-preference": [ "device1", "device2" ], // preference list deciding the displayed device
	"tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
	"tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
	"tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
	"tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
},
"pulseaudio": {
	"format": "[ {icon} {volume}% ]",
	"format-bluetooth": "[  {volume}% ]",
	"format-muted": "",
	"format-icons": {
		"alsa_output.pci-0000_00_1f.3.analog-stereo": "",
		"alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
		"headphone": "",
		"hands-free": "",
		"headset": "",
		"phone": "",
		"phone-muted": "",
		"portable": "",
		"car": "",
		"default": [" ", " "]
	},
	"scroll-step": 1,
	"on-click": "pavucontrol"
},

"custom/power": {
"tooltip": false,
"format": "[  Power ]",
"on-click":"wlogout"
},

"custom/themes": {
"tooltip": false,
"format": "[   Themes ]",
"on-click":"direnv exec /home/ranger/ranger097_nixos_dotfiles/python/theme_switcher python3 /home/ranger/ranger097_nixos_dotfiles/python/theme_switcher/themes.py"
},

}
